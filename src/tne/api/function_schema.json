{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "tne_encode",
        "description": "将九维三态向量编码为卦位索引，返回等价类信息。用于认知定位：确定当前处境在 19683 卦空间中的坐标。",
        "parameters": {
          "type": "object",
          "properties": {
            "vector": {
              "type": "array",
              "items": {"type": "integer", "enum": [-1, 0, 1]},
              "minItems": 9,
              "maxItems": 9,
              "description": "九维三态向量，每维 ∈ {-1,0,1}，g1=上爻 g9=下爻。阳(+1)=显/向外/生发，中和(0)=居间/耦合，阴(-1)=隐/向内/收敛。"
            }
          },
          "required": ["vector"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "tne_search",
        "description": "在 19683 卦全集中检索与目标向量最邻近的 Top-N 卦，用于邻域泛化：找到与当前处境相似的其他卦位及其解读。",
        "parameters": {
          "type": "object",
          "properties": {
            "vector": {
              "type": "array",
              "items": {"type": "integer", "enum": [-1, 0, 1]},
              "minItems": 9,
              "maxItems": 9,
              "description": "目标九维三态向量。"
            },
            "top_n": {
              "type": "integer",
              "default": 10,
              "description": "返回最近邻数量，默认 10。"
            }
          },
          "required": ["vector"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "tne_transform",
        "description": "对卦位执行全套结构变换：错卦(对偶)、综卦(反转)、错综、互卦(5维内核)、动爻变卦。用于多视角审视当前处境。",
        "parameters": {
          "type": "object",
          "properties": {
            "vector": {
              "type": "array",
              "items": {"type": "integer", "enum": [-1, 0, 1]},
              "minItems": 9,
              "maxItems": 9,
              "description": "待变换的九维三态向量。"
            },
            "moving_yaos": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1, "maximum": 9},
              "description": "动爻位集合（1-9，1=上爻），不传则只算错综互。"
            }
          },
          "required": ["vector"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "tne_habit",
        "description": "查询当前卦位的历史习惯偏置。命中高频等价类→返回习惯行为建议；未命中→建议探索模式。用于认知连续性与行为复用。",
        "parameters": {
          "type": "object",
          "properties": {
            "vector": {
              "type": "array",
              "items": {"type": "integer", "enum": [-1, 0, 1]},
              "minItems": 9,
              "maxItems": 9,
              "description": "当前九维三态向量。"
            }
          },
          "required": ["vector"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "tne_trajectory",
        "description": "记录一轮认知轨迹：(卦位, 行为, 结果, 奖励)。每轮 Agent 推理后必须调用，用于积累习惯与后续习惯偏置查询。",
        "parameters": {
          "type": "object",
          "properties": {
            "session_id": {"type": "string", "description": "会话/任务唯一标识。"},
            "vector": {
              "type": "array",
              "items": {"type": "integer", "enum": [-1, 0, 1]},
              "minItems": 9,
              "maxItems": 9,
              "description": "当前轮的九维三态向量。"
            },
            "action": {"type": "string", "description": "行为类型：tool_call / reasoning / final_answer 等。"},
            "action_detail": {"type": "object", "description": "行为详情 JSON。"},
            "outcome": {"type": "string", "enum": ["success", "failure", "partial"], "description": "结果。"},
            "reward": {"type": "number", "default": 0.0, "description": "奖励信号。"}
          },
          "required": ["session_id", "vector", "action"]
        }
      }
    }
  ],
  "system_prompt_suffix": "\n\n【认知层工具使用规范】\n你可以调用 tne_* 工具在三元九维 19683 认知空间中定位、泛化与积累习惯。\n- 每轮推理开始时，先用 tne_encode 将当前处境编码为卦位（需先将处境判断为九维三态向量）。\n- 需要借鉴相似经验时，用 tne_search 检索邻域卦。\n- 需要多视角审视时，用 tne_transform 获取错/综/互/变卦。\n- 决策前用 tne_habit 查询历史习惯偏置。\n- 每轮结束必须用 tne_trajectory 记录 (卦位, 行为, 结果)。\n认知层是可审计的坐标骨架，你的自然语言推理负责语义填充。"
}
